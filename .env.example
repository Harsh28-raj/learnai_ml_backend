# Postgres (Neon/Supabase) or SQLite. postgres:// and postgresql:// are rewritten to the psycopg driver.
DATABASE_URL=sqlite:///./learnai.db
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Comma-separated origins, or * to allow any origin (no credentials) during the hackathon.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Swagger UI at /docs and ReDoc at /redoc (the frontend integration guide).
ENABLE_DOCS=true
VERIFY_QUESTIONS=true
TUTOR_SUPPORT_TEXT=If you're feeling overwhelmed, please reach out to someone you trust or call Tele-MANAS at 14416 (India).
# Per-IP limits per minute (0 disables): AI actions (tutor_chat, generate_questions, assessment) / everything else.
RATE_LIMIT_LLM_PER_MIN=20
RATE_LIMIT_OTHER_PER_MIN=120
